# ==============================================================================
# LinkedIn Outreach Agent — Environment Configuration Template
# Copy this file to .env and customize it for your background and goals:
# cp .env.example .env
# ==============================================================================

# Server Configuration
PORT=3000

# Chrome Remote Debugging Port (default: 9222)
CHROME_DEBUG_PORT=9222

# ==============================================================================
# User Persona Configuration
# Customize these values so drafted messages authentically reflect YOUR profile!
# ==============================================================================
USER_NAME="Nihal"
USER_ROLE="AI Engineering Student & Startup Co-Founder"
USER_BACKGROUND="Hands-on builder focusing on AI agents, LLM pipelines, autonomous systems, and modern full-stack development."

# Outreach Objectives & Intent
USER_GOAL_INTERNSHIP="Summer/Fall AI Engineering internships and junior/associate builder roles."
USER_GOAL_FOUNDER="Networking with tech founders, exchanging early-stage building lessons, exploring strategic synergy."
USER_GOAL_TECHNICAL="Discussing AI agent architectures, autonomous workflows, and modern production LLM systems."
USER_GOAL_PEER="Connecting with fellow engineers and builders passionate about high-impact AI."

# ==============================================================================
# AI Provider (Optional)
# If OPENAI_API_KEY is not provided, the high-quality local heuristic engine
# will generate contextual, multi-variation drafts with zero external cost.
# ==============================================================================
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Extraction Limits
MAX_SCROLL_CYCLES=45
SCROLL_DELAY_MS=1600
